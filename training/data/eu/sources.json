{
  "schema_version": 1,
  "scope": "EU institutional content; inventories are not claims of completeness or novelty",
  "sources": [
    {
      "id": "eurlex",
      "name": "EUR-Lex / CELLAR laws",
      "institution": "Publications Office of the European Union",
      "priority": 1,
      "pilot": true,
      "description": "Published laws, regulations, directives and decisions. Start with negotiated native XHTML; expand using CELLAR metadata and change feeds.",
      "seed_urls": [
        "https://publications.europa.eu/resource/celex/32016R0679"
      ],
      "allowed_hosts": [
        "publications.europa.eu",
        "eur-lex.europa.eu",
        "op.europa.eu"
      ],
      "request_headers": {
        "Accept": "application/xhtml+xml",
        "Accept-Language": "eng"
      },
      "language": "en",
      "document_url_patterns": [
        "/resource/celex/",
        "/resource/cellar/.*/DOC_",
        "/legal-content/[^/]+/TXT/"
      ],
      "discovery_url_patterns": [],
      "reference_urls": [
        "https://op.europa.eu/en/web/cellar/cellar-data/publications",
        "https://op.europa.eu/en/web/cellar/cellar-data/rss-and-atom-feeds"
      ],
      "expansion": [
        "SPARQL inventory",
        "all available document languages",
        "notification feed",
        "version relationships"
      ],
      "existing_overlap": "Eurlex Resources, MultiLegalPile, JRC-Acquis and DGT; no novelty assumed."
    },
