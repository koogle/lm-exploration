{
  "name": "study-128m-marin-conv",
  "family": "hybrid",
  "description": "Short convolutions (kernel 4, identity init) on full-attention keys, values and output and on every MLP output; otherwise the control.",
  "stages": [
    {
      "stage": "data",
      "name": "corpus",
      "recipe": "hybrid/recipes/kda-mix-study-v3.json",
      "parallel": 8
    },
    {
      "stage": "pretrain",
      "name": "pretrain",
      "data": "corpus",
      "model_config": "hybrid/configs/study-128m-marin-conv.json",
      "gpu": "H100",
      "world_size": 1,
      "segment_seconds": 7200,
      "worker_timeout_seconds": 8100,
      "max_segments": 3,
      "segments_per_call": 3,
      "qualification_segments": 1,
      "qualification_steps": 8
    }
  ]
}
