{
  "description": "Modern 10M character GPT on Tiny Shakespeare; training settings from the historical vanilla shakespeare-10m-train-01 run.",
  "model": "10m",
  "dataset": "tiny-shakespeare",
  "training": {
    "steps": 4000,
    "batch_size": 32,
    "lr": 0.0003,
    "seed": 1337,
    "eval_interval": 200,
    "log_interval": 200,
    "eval_batches": 20,
    "checkpoint_interval": 200
  },
  "backend": {
    "gpu": "L4",
    "max_seconds": 1200,
    "timeout_seconds": 1500
  }
}
