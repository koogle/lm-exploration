{
  "name": "hybrid-720m-rl",
  "description": "Chat SFT of the hybrid 720M 40B export (chat-sft-v1 with pretraining replay), then RL with verifiable rewards on GSM8K, MATH levels 1-3 and KodCode",
  "family": "hybrid",
  "from": "hybrid-720m-40b-01/export/tokens-039998980096",
  "stages": [
    {
      "stage": "midtrain",
      "name": "chat-sft",
      "description": "One epoch of chat-sft-v1 (96 chat and 32 replay rows per step)",
      "model_config": "hybrid/configs/hybrid-720m-chat-sft.json",
      "gpu": "H100",
      "world_size": 8,
      "segment_seconds": 82000,
      "worker_timeout_seconds": 84000,
      "max_segments": 2,
      "segments_per_call": 1,
      "qualification_segments": 0
    },
    {
      "stage": "rl",
      "name": "rl",
      "description": "Dr. GRPO with Muon on 8 H100s at the rates of the rl-v1 run behind the Space's model (hybrid-720m-rl-lr-low-01): 128 prompts (16 per GPU) x 8 answers per step, 768-token answers",
      "pool": "rl-pool-hybrid-01",
      "gpus": 8,
      "settings": {
        "steps": 1000,
        "algorithm": {
          "name": "on_policy/grpo"
        },
        "rollouts": {
          "prompts_per_step": 128,
          "samples_per_prompt": 8,
          "math_share": 0.65,
          "math_tokens": 768,
          "code_tokens": 768,
          "temperature": 1.0
        },
        "optimizer": {
          "muon": true,
          "muon_lr": 0.0001,
          "lr": 1.5e-06,
          "betas": [
            0.9,
            0.95
          ],
          "weight_decay": 0.0,
          "warmup_steps": 10
        },
        "micro_batch": 4,
        "evaluate_every": 25,
        "save_every": 100
      }
    }
  ]
}
