{
  "name": "climbmix-124m-overlap-smoke",
  "family": "subword",
  "stages": [
    {
      "stage": "data",
      "name": "corpus",
      "dataset_config": "workflows/datasets/climbmix-code-v4-raw.json",
      "version": "climbmix-code-v4"
    },
    {
      "stage": "pretrain",
      "name": "pretrain",
      "data": "corpus",
      "model_config": "workflows/model_configs/modern-124m.json",
      "target_tokens": 300000000,
      "allow_unreviewed_data": true,
      "pilot": true,
      "gpu": "H100",
      "world_size": 1,
      "segment_seconds": 600,
      "worker_timeout_seconds": 1800,
      "max_segments": 3,
      "segments_per_call": 3,
      "qualification_segments": 1,
      "qualification_steps": 2,
      "source_workers": 6,
      "tokenizer_threads": 8,
      "database_batch_size": 1024,
      "preparation_chunk_seconds": 20,
      "overlap_preparation": true
    }
  ]
}
