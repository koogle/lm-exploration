{
  "family": "subword",
  "model_config": "model_configs/modern-124m.json",
  "dataset_config": "datasets/climbmix-code-v4-raw.json",
  "target_tokens": 300000000,
  "allow_unreviewed_data": true,
  "pilot": true,
  "gpu": "H100",
